cabal-version: 3.8
name: airake-openrouter
version: 0.2.0.0
synopsis: Typed AI operations and composable backends
category: AI
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
author: Tommy Engström
maintainer: tommy@tommyengstrom.com
homepage: https://github.com/tommyengstrom/ai-rake
description: See README.md for the package interface and architecture.
extra-source-files: README.md

common shared_opts
  default-language: GHC2024
  default-extensions:
      AllowAmbiguousTypes
      BlockArguments
      DataKinds
      DefaultSignatures
      DeriveAnyClass
      DerivingStrategies
      DerivingVia
      DuplicateRecordFields
      FunctionalDependencies
      GeneralizedNewtypeDeriving
      LambdaCase
      NoFieldSelectors
      NoImplicitPrelude
      NoStarIsType
      OverloadedLabels
      OverloadedLists
      OverloadedStrings
      RecordWildCards
      StrictData
      TemplateHaskell
      TupleSections
      TypeApplications
      TypeFamilyDependencies
      TypeOperators
      ViewPatterns

  ghc-options:
    -Weverything
    -Werror
    -Wno-all-missed-specialisations
    -Wno-missed-specialisations
    -Wno-implicit-prelude
    -Wno-missing-export-lists
    -Wno-missing-import-lists
    -Wno-missing-local-signatures
    -Wno-missing-safe-haskell-mode
    -Wno-prepositive-qualified-module
    -Wno-safe
    -Wno-unsafe
    -Wno-missing-kind-signatures
    -Wno-missing-poly-kind-signatures
    -Wno-monomorphism-restriction
    -Wno-missing-role-annotations
    -Wno-partial-fields
    -Wno-unused-packages


library
  import: shared_opts
  hs-source-dirs: src
  exposed-modules:
      Rake.Providers.OpenRouter.Chat
      Rake.Providers.OpenRouter.ImageModels
      Rake.Providers.OpenRouter.Images
      Rake.Providers.OpenRouter.Models.GeminiFlashLiteImage31
      Rake.Providers.OpenRouter.Models.GeminiNanoBanana21
      Rake.Providers.OpenRouter.Models.GeminiProImage3
      Rake.Providers.OpenRouter.Models.GptImage25Flare
      Rake.Providers.OpenRouter.Models.GptImage25Sunburst
      Rake.Providers.OpenRouter.Models.GrokImagineImage20
      Rake.Providers.OpenRouter.Models.GrokImagineVideo15
      Rake.Providers.OpenRouter.Models.Veo31
      Rake.Providers.OpenRouter.Settings
      Rake.Providers.OpenRouter.TTS
      Rake.Providers.OpenRouter.Videos
  other-modules:
      Rake.Providers.OpenRouter.Internal.Audio
      Rake.Providers.OpenRouter.Internal.Http
      Rake.Providers.OpenRouter.Internal.Projection
      Rake.Providers.OpenRouter.Internal.Request
      Rake.Providers.OpenRouter.Internal.Responses
      Rake.Providers.OpenRouter.Internal.Sse
  build-depends: base >=4.20 && <5, aeson, bytestring, containers, effectful, effectful-core, relude, text, time, vector, airake-core, http-client, http-client-tls, http-types, servant, servant-client, servant-client-core, unliftio, base64-bytestring

test-suite unit
  import: shared_opts
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  other-modules:
      Rake.OpenRouter.HttpSpec
      Rake.OpenRouter.ModelsSpec
  build-tool-depends: hspec-discover:hspec-discover
  build-depends: base >=4.20 && <5, aeson, bytestring, containers, effectful, effectful-core, relude, text, time, vector, hspec, QuickCheck, directory, filepath, unliftio, process, effectful-plugin, airake-openrouter, airake-core, airake-chat, wai, warp, http-types, base64-bytestring
