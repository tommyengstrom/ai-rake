cabal-version: 3.8
name: airake-openai
version: 0.2.0.0
synopsis: Typed AI operations and composable backends
category: AI
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
author: Tommy Engström
maintainer: tommy@tommyengstrom.com
homepage: https://github.com/tommyengstrom/ai-rake
description: See README.md for the package interface and architecture.
extra-source-files: README.md

common shared_opts
  default-language: GHC2024
  default-extensions:
      AllowAmbiguousTypes
      BlockArguments
      DataKinds
      DefaultSignatures
      DeriveAnyClass
      DerivingStrategies
      DerivingVia
      DuplicateRecordFields
      FunctionalDependencies
      GeneralizedNewtypeDeriving
      LambdaCase
      NoFieldSelectors
      NoImplicitPrelude
      NoStarIsType
      OverloadedLabels
      OverloadedLists
      OverloadedStrings
      RecordWildCards
      StrictData
      TemplateHaskell
      TupleSections
      TypeApplications
      TypeFamilyDependencies
      TypeOperators
      ViewPatterns

  ghc-options:
    -Weverything
    -Werror
    -Wno-all-missed-specialisations
    -Wno-missed-specialisations
    -Wno-implicit-prelude
    -Wno-missing-export-lists
    -Wno-missing-import-lists
    -Wno-missing-local-signatures
    -Wno-missing-safe-haskell-mode
    -Wno-prepositive-qualified-module
    -Wno-safe
    -Wno-unsafe
    -Wno-missing-kind-signatures
    -Wno-missing-poly-kind-signatures
    -Wno-monomorphism-restriction
    -Wno-missing-role-annotations
    -Wno-partial-fields
    -Wno-unused-packages


library
  import: shared_opts
  hs-source-dirs: src
  exposed-modules:
      Rake.Providers.OpenAI.Chat
      Rake.Providers.OpenAI.Images
      Rake.Providers.OpenAI.TTS
  other-modules:
      Rake.Internal.Sse
      Rake.Providers.Chat.Projection
      Rake.Providers.Chat.Responses
      Rake.Providers.Internal
      Rake.Providers.TTS.Internal
  build-depends: base >=4.20 && <5, aeson, bytestring, containers, effectful, effectful-core, relude, text, time, vector, airake-core, http-client, http-client-tls, http-types, servant, servant-client, servant-client-core, unliftio

test-suite unit
  import: shared_opts
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  other-modules:
      Rake.MediaReplaySpec
      Rake.Provider.MediaSpec
      Rake.Provider.ResponsesRenderSpec
      StructuredSchemaTestTypes
  build-tool-depends: hspec-discover:hspec-discover
  build-depends: base >=4.20 && <5, aeson, bytestring, containers, effectful, effectful-core, relude, text, time, vector, hspec, QuickCheck, directory, filepath, unliftio, process, effectful-plugin, airake-openai, uuid, airake-core, airake-chat, openapi3, monad-time-effectful, base64-bytestring, wai, warp, http-types, servant-client, servant-client-core, optics-core, http-client

flag integration
  description: Enable explicitly requested database or provider integration tests
  default: False
  manual: True

test-suite live
  import: shared_opts
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: integration
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  other-modules:
      ProviderAgnosticTests
      ProviderStructuredSchemaBehaviorTests
      Rake.Provider.OpenAISpec
      StructuredSchemaTestTypes
  build-tool-depends: hspec-discover:hspec-discover
  build-depends: base >=4.20 && <5, aeson, bytestring, containers, effectful, effectful-core, relude, text, time, vector, hspec, QuickCheck, directory, filepath, unliftio, process, effectful-plugin, airake-openai, uuid, airake-core, airake-chat, openapi3, monad-time-effectful, base64-bytestring, wai, warp, http-types, servant-client, servant-client-core, optics-core, http-client
  if !flag(integration)
    buildable: False
