cabal-version: 3.8
name: airake-chat
version: 0.2.0.0
synopsis: Typed AI operations and composable backends
category: AI
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
author: Tommy Engström
maintainer: tommy@tommyengstrom.com
homepage: https://github.com/tommyengstrom/ai-rake
description: See README.md for the package interface and architecture.
extra-source-files: README.md

common shared_opts
  default-language: GHC2024
  default-extensions:
      AllowAmbiguousTypes
      BlockArguments
      DataKinds
      DefaultSignatures
      DeriveAnyClass
      DerivingStrategies
      DerivingVia
      DuplicateRecordFields
      FunctionalDependencies
      GeneralizedNewtypeDeriving
      LambdaCase
      NoFieldSelectors
      NoImplicitPrelude
      NoStarIsType
      OverloadedLabels
      OverloadedLists
      OverloadedStrings
      RecordWildCards
      StrictData
      TemplateHaskell
      TupleSections
      TypeApplications
      TypeFamilyDependencies
      TypeOperators
      ViewPatterns

  ghc-options:
    -Weverything
    -Werror
    -Wno-all-missed-specialisations
    -Wno-missed-specialisations
    -Wno-implicit-prelude
    -Wno-missing-export-lists
    -Wno-missing-import-lists
    -Wno-missing-local-signatures
    -Wno-missing-safe-haskell-mode
    -Wno-prepositive-qualified-module
    -Wno-safe
    -Wno-unsafe
    -Wno-missing-kind-signatures
    -Wno-missing-poly-kind-signatures
    -Wno-monomorphism-restriction
    -Wno-missing-role-annotations
    -Wno-partial-fields
    -Wno-unused-packages


library
  import: shared_opts
  hs-source-dirs: src
  exposed-modules:
      Rake.Chat
      Rake.MediaStorage.Directory
      Rake.MediaStorage.InMemory
      Rake.Storage.Effect
      Rake.Storage.InMemory
      Rake.Tool
  build-depends: base >=4.20 && <5, aeson, bytestring, containers, effectful, effectful-core, relude, text, time, vector, effectful-th, airake-core, directory, filepath, filelock, monad-time-effectful, openapi3, uuid

test-suite unit
  import: shared_opts
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  other-modules:
      Rake.ChatSpec
      Rake.MediaStorage.DirectorySpec
      Rake.ReplaySpec
      Rake.Storage.InMemorySpec
      Rake.TypesSpec
      StructuredSchemaTestTypes
  build-tool-depends: hspec-discover:hspec-discover
  build-depends: base >=4.20 && <5, aeson, bytestring, containers, effectful, effectful-core, relude, text, time, vector, hspec, QuickCheck, directory, filepath, unliftio, process, effectful-plugin, airake-chat, airake-core, openapi3, monad-time-effectful, uuid, unliftio-pool, deepseq, optics-core, hashable, unordered-containers, http-types
