cabal-version: 3.8
name: airake-backend-fixture
version: 0.2.0.0
build-type: Simple
license: BSD-3-Clause
synopsis: Independent backend compilation fixture
category: Testing
maintainer: tommy@tommyengstrom.com
description: Verifies that third-party adapters need only the public core package.

test-suite independent-backend
  type: exitcode-stdio-1.0
  main-is: Main.hs
  default-language: GHC2024
  ghc-options: -Wall -Werror
  build-depends: base, airake-core, effectful
